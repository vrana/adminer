includes:
	- ../vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	level: 6
	checkNullables: true # level 8
	# stricter checks which currently report no error
	checkUninitializedProperties: true # typed property without a default value
	checkDynamicProperties: true # property not declared in the class
	checkFunctionNameCase: true
	checkMissingCallableSignature: true # callable without the types of its parameters
	reportAnyTypeWideningInVarTag: true # @var widening the inferred type
	reportMaybesInMethodSignatures: true # nullable parameter and return types of overridden methods
	reportMaybesInPropertyPhpDocTypes: true
	reportStaticMethodSignatures: true

	# the strict rules which currently report no error, the others are listed at the end of the file
	strictRules:
		allRules: false
		closureUsesThis: true
		disallowedBacktick: true
		disallowedImplicitArrayCreation: true
		dynamicCallOnStaticMethod: true
		illegalConstructorMethodCall: true
		matchingInheritedMethodNames: true
		switchConditionsMatchingType: true
	# rules.neon enables these outside strictRules so we set them back
	polluteScopeWithLoopInitialAssignments: true # for ($i=0; ...) defines $i even if the loop doesn't run
	polluteScopeWithAlwaysIterableForeach: true # foreach (array($base) as ...) defines the variables too
	reportWrongPhpDocTypeInVarTag: false # @var is used to narrow the type, e.g. PDOStatement to Result

	ignoreErrors:
		# need to fix
		- "~Adminer\\\\Result.*mysqli_result~" # mysqli_result
		- "~Function Adminer\\\\queries\\(\\) never returns Adminer\\\\Result~" # mysqli_result

		# not real problems
		- identifier: include.fileNotFound # includes in include/ relative from index.php
		- "~^Function (set_magic_quotes_runtime|mysql_)~" # PHP < 7 functions
		-
			identifier: booleanAnd.rightAlwaysFalse # function_exists() of the PHP < 7 functions
			path: ../adminer/include/bootstrap.inc.php
		- "~an unknown class OCI-?Lob~" # this looks like PHPStan bug
		- "~^Variable \\$error might not be defined~" # declared in bootstrap.inc.php
		- "~^Constant LANG not found~" # defined in lang.inc.php
		- "~^Constant SESSION_NAME not found~" # defined in bootstrap.inc.php
		- "~ an undefined \\w+ Adminer\\\\Db::~" # defined in that versions of Db
		-
			identifier: impureFunction.pure # stubs of functions that are impure in other drivers
			path: ../adminer/drivers/mysql.inc.php
		- "~^Call to an undefined method Adminer\\\\Result::seek~" # defined in MS SQL
		- "~^Call to an undefined method Adminer\\\\Driver::(setUserTypes|tableOid)~" # defined in PostgreSQL
		- "~^Call to an undefined method Adminer\\\\Adminer.*::_foreignColumn~" # defined in Editor
		- "~^Access to an undefined property Adminer\\\\Driver::\\$nsOid~" # defined in PostgreSQL
		- "~^Class Adminer\\\\PdoDb has an uninitialized property \\$pdo~" # assigned in dsn() which is called right after the constructor
		- "~expects int, float given~" # this will work
		- "~expects bool~" # truthy values
		- "~fread expects int<1, max>, 100000~" # 1e6
		- "~'strlen' given~" # used as a bool callback
		- "~between int<70100~" # PHP_VERSION_ID check
		-
			message: "~implode expects array, string given~" # pg_last_notice() returns array with PGSQL_NOTICE_ALL
			path: ../adminer/drivers/pgsql.inc.php
		-
			message: "~ type specified~" # duplicate functions and methods, the doc-comments with array types are in adminer/
			paths:
				- ../adminer/include/pdo.inc.php
				- ../adminer/drivers/*
				- ../editor/*

		# it probably doesn't like $ar[$key] instead of isset($ar[$key]) and thinks that $ar[$key] is always set
		- identifier: identical.alwaysFalse
		- identifier: notIdentical.alwaysTrue
		- identifier: booleanNot.alwaysTrue
		- identifier: booleanNot.alwaysFalse
		- identifier: booleanAnd.leftAlwaysTrue
		- identifier: booleanAnd.rightAlwaysTrue
		- identifier: booleanOr.rightAlwaysTrue
		- identifier: ternary.alwaysTrue
		- identifier: if.alwaysTrue
		- identifier: isset.offset
		- identifier: deadCode.unreachable
		- "~Function Adminer\\\\get_driver\\(\\) never returns null~"

	paths:
		- ../adminer/drivers/mysql.inc.php # other drivers inherit the annotations so we take them from here
		- ../adminer/
		- ../editor/
	scanFiles:
		- ../compile.php # compile_file()
	excludePaths:
		- ../adminer/static/jush # submodule
		- ../adminer/adminer-plugins*
		- ../adminer/designs.php
		- ../editor/example.php

	phpVersion:
		min: 70100
		max: 80499

	dynamicConstantNames:
		- Adminer\VERSION # the value changes with every release so the -dev check in file.inc.php must stay undecided
		- SID # empty when the session ID is in a cookie

	# The strict rules which are not used, with the number of places they report (measured 2026-08-09):
	# booleansInConditions, booleansInLoopConditions (773) - a truthy value is used on purpose
	# disallowedLooseComparison (855) - $var != "" is used on purpose because a table can be named 0
	# strictFunctionCalls (57) - the third parameter of in_array() would have to be added everywhere
	# disallowedShortTernary (36) - ?: saves bytes
	# uselessCast (19) - the casts guard against an undefined array key which PHPStan doesn't see
	# overwriteVariablesWithLoop (19) - e.g. $i = -1 before a foreach which may not run
	# strictArrayFilter (4) - array_filter() removes the empty values on purpose
	# disallowedEmpty (2) - each of them needs to be decided separately
	# requireParentConstructorCall (1) - Db::__construct() calls parent::init() instead
	# noVariableVariables (1) - $$val is used to read the superglobals in bootstrap.inc.php

	typeAliases:
		TableStatus: "array{Name:string, Engine?:?string, Comment?:string, Oid?:numeric-string, Rows?:?numeric-string, Collation?:string, Auto_increment?:?numeric-string, Data_length?:numeric-string, Index_length?:numeric-string, Data_free?:numeric-string, Create_options?:string, partition?:numeric-string, nspname?:string}"
		Field: "array{field?:string, full_type:string, type:string, length?:?numeric-string, unsigned?:string, default?:string, null:bool, auto_increment:bool, collation?:string, privileges:int[], comment?:string, primary?:bool, generated?:string, composite?:bool, orig?:string, on_update?:string, on_delete?:string, default_constraint?: string}"
		FieldType: "array{type:string, length:numeric-string, unsigned:string, collation:string}" # subset of RoutineField and Field
		RoutineField: "array{field:string, type:string, length:numeric-string, unsigned:string, null:bool, full_type:string, collation:string, inout?:string}"
		Index: "array{type:string, columns:list<string>, lengths:list<numeric-string>, descs:list<?bool>, opclasses?:string[], algorithm?:string, partial?:string}"
		ForeignKey: "array{db?:string, ns?:string, table:string, source:list<string>, target:list<?string>, on_delete:string, on_update?:string, definition?:string, deferrable?:string}"
		Trigger: "array{Trigger?:string, Timing?:string, Event?:string, Of?:string, Type?:string, Statement?:string}"
		Routine: "array{name?:string, fields:list<RoutineField>, comment:string, returns?:FieldType, definition:string, language?:string}"
		Partitions: "array{partition_by?:string, partition?:string, partitions?:numeric-string, partition_names?:list<string>, partition_values?:list<string>}"
		BackwardKey: "array{name:string, keys:string[][]}"
